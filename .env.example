# =========================
# APPLICATION
# =========================
SERVER_PORT=8080

# =========================
# DATABASE
# =========================
MYSQL_ROOT_PASSWORD=CHANGE_ME
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# =========================
# JWT
# =========================
APP_JWT_SECRET=CHANGE_ME_WITH_SECURE_KEY
APP_JWT_EXPIRATION_MS=86300000

# =========================
# CORS
# =========================
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =========================
# EMAIL
# =========================
SPRING_MAIL_ENABLED=true
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password
SPRING_MAIL_FROM=your-email@gmail.com

# =========================
# TWILIO
# =========================
TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# =========================
# RAZORPAY
# =========================
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_CONSULTATION_FEE=200.00
APP_PAYMENT_REQUIRED=true

# =========================
# ML SERVICE
# =========================
APP_ML_SERVICE_ENABLED=true
APP_ML_SERVICE_URL=http://ml-service:8000

APP_BUSINESS_TIMEZONE=Asia/Kolkata
